{
  "name": "kumo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "firebase": "^11.1.0",
    "firebase-admin": "^14.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync:vercel-env": "node scripts/sync-vercel-env.mjs",
    "verify:vercel-account": "node scripts/verify-vercel-account.mjs",
    "validate:config": "node -e \"JSON.parse(require('node:fs').readFileSync('database.rules.json','utf8')); JSON.parse(require('node:fs').readFileSync('firebase.json','utf8')); JSON.parse(require('node:fs').readFileSync('vercel.json','utf8'))\""
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^7.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.28.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vercel": "^59.4.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
